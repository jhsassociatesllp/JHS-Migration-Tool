# ---- Backend (FastAPI) — local dev ----
# SQLite database file for configuration/state (projects, files, mappings, runs).
# Ignored if DATABASE_URL is set (see "Docker / production" below) — production uses
# Postgres instead.
APP_DB_PATH=./storage/app.db

# Root folder for uploaded CSVs, generated Parquet copies, validation
# results, and exports. Each project gets its own isolated subfolder.
APP_STORAGE_ROOT=./storage

# Comma-separated list of origins allowed to call the API (CORS). Only relevant in local
# dev, where the frontend (Vite, :5173) and backend (:8000) are separate origins —
# production serves both from the same origin/container, so CORS doesn't apply there.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend (Vite) — local dev ----
# Not required in local dev (Vite proxies /api to localhost:8000 — see
# frontend/vite.config.ts). Set this if you deploy the API on a different
# host/port than the frontend.
VITE_API_BASE_URL=/api

# ---- Docker / production (docker-compose.yml) ----
# This section is NOT read by `uvicorn main:app --reload` directly — it's what
# docker-compose.yml turns into the container's real environment. Copy this file to
# `.env` next to docker-compose.yml on the deploy target and fill in real values (the
# GitHub Actions workflow does this automatically from repo secrets on first deploy —
# see docs/DEPLOYMENT_BHARAT_CLOUD.md).
#
# DB_USER=migrationtool
# DB_PASSWORD=          # generate with: openssl rand -base64 24
# DB_NAME=migrationtool
# APP_PORT=8050         # host port the app is published on
